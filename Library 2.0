-- Lumen UI 2.0 | Client-side Roblox / LuaU
-- Original AddWindow/AddTab/Add* calling conventions, with a new interface.
-- No external UI assets, downloaded code, polling loops, or game automation.
-- AddSlider:Set(0..100) keeps the original percentage API.
-- AddSlider:SetValue(number) uses the actual min/max range.

local Players = game:GetService("Players")
local InputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local TextService = game:GetService("TextService")
local Workspace = game:GetService("Workspace")

local library = { Version = "2.0.0", _windows = {}, _bindings = {}, _toasts = {} }
local Container = {}
Container.__index = Container
local WHITE = Color3.fromRGB(255, 255, 255)
local DEFAULT_ACCENT = Color3.fromRGB(116, 83, 205)
local RUNTIME_KEY = "__LumenUIRuntime_v2"
local closePopup, refreshSearch, disposeWindow

local function call(callback, ...)
    if type(callback) ~= "function" then return end
    local ok, message = pcall(callback, ...)
    if not ok then warn("[Lumen UI callback] " .. tostring(message)) end
end

local function numeric(value, fallback)
    local result = tonumber(value)
    if not result or result ~= result or math.abs(result) == math.huge then return fallback end
    return result
end

local function make(className, parent, properties)
    local object = Instance.new(className)
    if object:IsA("GuiObject") then
        object.BorderSizePixel = 0
        object.ZIndex = parent and parent:IsA("GuiObject") and parent.ZIndex + 1 or 1
    end
    if object:IsA("GuiButton") then
        object.AutoButtonColor = false
        object.Text = ""
        object.Font = Enum.Font.GothamMedium
    end
    for key, value in pairs(properties or {}) do object[key] = value end
    object.Parent = parent
    return object
end

local function corner(object, radius)
    return make("UICorner", object, { CornerRadius = UDim.new(0, radius or 12) })
end

local function stroke(object, color, transparency, thickness)
    return make("UIStroke", object, {
        Color = color,
        Transparency = transparency or 0,
        Thickness = thickness or 1,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    })
end

local function padding(object, left, top, right, bottom)
    return make("UIPadding", object, {
        PaddingLeft = UDim.new(0, left or 0),
        PaddingTop = UDim.new(0, top or 0),
        PaddingRight = UDim.new(0, right or left or 0),
        PaddingBottom = UDim.new(0, bottom or top or 0),
    })
end

local function label(parent, text, position, size, color, fontSize, font)
    return make("TextLabel", parent, {
        BackgroundTransparency = 1,
        Position = position or UDim2.new(),
        Size = size or UDim2.new(1, 0, 0, 22),
        Font = font or Enum.Font.GothamMedium,
        Text = tostring(text or ""),
        TextSize = fontSize or 13,
        TextColor3 = color or Color3.fromRGB(47, 39, 67),
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
    })
end

local function theme(accent)
    return {
        accent = accent,
        pale = accent:Lerp(WHITE, 0.91),
        header = accent:Lerp(Color3.fromRGB(37, 25, 66), 0.15),
        background = Color3.fromRGB(248, 247, 252),
        surface = WHITE,
        border = Color3.fromRGB(232, 225, 244),
        text = Color3.fromRGB(48, 39, 67),
        muted = Color3.fromRGB(139, 129, 158),
        inactive = Color3.fromRGB(220, 216, 231),
        green = Color3.fromRGB(68, 153, 121),
